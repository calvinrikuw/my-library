<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.library.service.repository.BookMapper">

    <resultMap id="BookResult" type="com.example.library.core.dto.FindBookDto">
        <id     column="id"         property="id"/>
        <result column="title"      property="title"/>
        <result column="author"     property="author"/>
        <result column="isbn"       property="isbn"/>
        <result column="categories" property="categories"/>
        <result column="summary"    property="summary"/>
        <result column="cover_url"  property="coverUrl"/>
    </resultMap>

    <select id="find" resultMap="BookResult">
        SELECT
        id, title, author, isbn, categories, summary, cover_url
        FROM books
        <where>
            is_deleted = 0
            <if test="keywords != null and keywords.size() > 0">
                <foreach collection="keywords" item="kw">
                    AND (
                    title LIKE CONCAT('%', #{kw}, '%')
                    OR author LIKE CONCAT('%', #{kw}, '%')
                    )
                </foreach>
            </if>
        </where>
        ORDER BY id DESC
        <if test="limit != null and limit &gt; 0">
            LIMIT #{limit}
        </if>
    </select>

</mapper>
